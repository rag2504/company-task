# Backend environment (copy to `.env` — do not commit secrets)

NODE_ENV=development
# Local only — do NOT add PORT or HOST on Render (the platform sets PORT; app binds 0.0.0.0).
# PORT=5000
# HOST=127.0.0.1

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/quickbill
JWT_SECRET=replace-with-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated browser origins (required on Render for Netlify login/API)
# FRONTEND_ORIGINS=http://localhost:3000,https://quickbill-point.netlify.app
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional seed overrides (see npm run seed)
# SEED_EMAIL=demo@quickbill.app
# SEED_PASSWORD=demo12345
